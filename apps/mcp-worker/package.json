{
  "name": "@missing-elements/h5p-mcp-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "stage": "pnpm --filter @missing-elements/h5p-offline-player build:plan && pnpm --filter @missing-elements/h5p-author exec node scripts/copy-skill.mjs && node scripts/stage.mjs",
    "dev": "pnpm stage && wrangler dev",
    "deploy:worker": "pnpm stage && wrangler deploy",
    "test": "pnpm stage && vitest run",
    "typecheck": "pnpm --filter @missing-elements/h5p-author run types && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@missing-elements/h5p-author": "workspace:*",
    "@missing-elements/h5p-libraries": "workspace:*",
    "@missing-elements/h5p-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.167.0"
  }
}
